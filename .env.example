# ============================================================
# 麦当劳中国 MCP 配置
# ============================================================
# 重要：不要在本文件里填写真实 Token。复制成 .env.local 后再填写本地值；
# .env / .env.* 已被 .gitignore 忽略，仓库只保留这个空模板。
#
# Token 获取：https://open.mcd.cn/mcp （手机号登录 -> Console -> 激活）

# 浏览器只请求同源代理；不要在这里放 Token。
VITE_MCD_MCP_URL=/api/mcp

# 100 积分 -> 5 枚游戏代币的积分商城 SKU（从 mall-points-products / mall-product-detail 获取）
VITE_MCD_COIN_SKU_ID=

# 3 个掉落虚拟鸡块 -> 1 张真实麦乐鸡券的积分商城 SKU
VITE_MCD_COUPON_SKU_ID=

# 可选：直接覆盖 mall-create-order 的完整 arguments（JSON）
# VITE_MCD_COIN_ORDER_ARGS={"skuId":123456,"count":1}
# VITE_MCD_COUPON_ORDER_ARGS={"skuId":654321,"count":1}

# 可选：每次下单数量，默认 1
VITE_MCD_COIN_COUNT=1
VITE_MCD_COUPON_COUNT=1

# 仅本地开发/验收：无 Token 时使用 mock，不请求真实账户。
# 生产必须为 0，否则会绕过真实积分扣减。
VITE_MCD_MOCK=0
# VITE_MCD_MOCK_POINTS=1000

# ===== 以下变量只在 Node/Vite 代理进程读取，不会进入前端 bundle =====
MCD_MCP_ENDPOINT=https://mcp.mcd.cn
# 在 .env.local 中填写真实 Token；本模板保持为空。
MCD_MCP_TOKEN=
